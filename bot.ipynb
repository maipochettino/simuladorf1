    "def cmd_problema(message):\n",
    "    print(\"alguien tiene un problema\")\n",
    "    bot_inicio.reply_to(message,\"Ok, ya se lo pase a un admin, en un rato será solucionado\")\n",
    "    print(\"se envio el problema del usuario\")\n",
